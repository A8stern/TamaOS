#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
registry="$root/harness/projects"
action=${1:-help}
selected=${2:-}

usage() {
  cat <<'EOF'
Usage: make <action> [PROJECT=<name>]

Actions:
  setup      check local prerequisites and set up registered projects
  check      run repository checks and project static checks
  test       run harness tests and project tests
  build      build registered projects
  ci         run check, test, and build without hardware access
  review     validate three local independent review reports
  prepush    run ci and the local review gate
  firmware   build firmware through the selected project harness
  size       report size through the selected project harness
  flash      flash the selected project; PROJECT is required
  monitor    monitor the selected project; PROJECT is required

Register projects in harness/projects. Each project provides an executable
.harness file accepting the action as its only argument.
EOF
}

case "$action" in
  help|-h|--help)
    usage
    exit 0
    ;;
  ci)
    "$0" check "$selected"
    "$0" test "$selected"
    "$0" build "$selected"
    exit 0
    ;;
  setup)
    for command in git make python3; do
      command -v "$command" >/dev/null 2>&1 || {
        echo "missing required command: $command" >&2
        exit 1
      }
    done
    git -C "$root" config core.hooksPath .githooks
    echo "Configured local Git hooks from .githooks."
    ;;
  check)
    python3 "$root/harness/check_repo.py" "$root"
    ;;
  test)
    python3 -m unittest discover -s "$root/harness" -p 'test_*.py'
    ;;
  build|firmware|size|flash|monitor)
    ;;
  *)
    echo "unknown action: $action" >&2
    usage >&2
    exit 2
    ;;
esac

case "$action" in
  flash|monitor)
    if [ -z "$selected" ]; then
      echo "PROJECT is required for $action" >&2
      exit 2
    fi
    ;;
esac

found=0
matched=0
tab=$(printf '\t')
while IFS="$tab" read -r name path extra; do
  case "$name" in
    ''|'#'*) continue ;;
  esac
  found=1
  if [ -n "$selected" ] && [ "$selected" != "$name" ]; then
    continue
  fi
  matched=1
  project_harness="$root/$path/.harness"
  printf '\n==> %s: %s\n' "$name" "$action"
  "$project_harness" "$action"
done < "$registry"

if [ -n "$selected" ] && [ "$matched" -eq 0 ]; then
  echo "unknown project: $selected" >&2
  exit 2
fi

if [ "$found" -eq 0 ] && [ "$action" != setup ] && [ "$action" != check ] && [ "$action" != test ]; then
  echo "No projects registered; repository checks are the only active harness." 
fi
